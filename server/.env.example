# ============================================
# 通义千问 API 配置
# ============================================
# 获取地址：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-your-api-key-here

# ============================================
# 模型配置
# ============================================
# 可选模型：qwen-turbo（最快最便宜）/ qwen-plus（平衡）/ qwen-max（最强）
# 学习建议：先用 qwen-turbo 调试，正式使用用 qwen-plus
QWEN_MODEL=qwen-turbo

# 温度参数：0~2，值越低回答越确定/保守，值越高越有创造性
# 客服场景建议 0.3~0.7
TEMPERATURE=0.7

# 单次回复最大 Token 数（1 Token ≈ 1.5 个汉字）
MAX_TOKENS=2048

# ============================================
# 服务配置
# ============================================
PORT=3001

# ============================================
# 数据存储目录（Sealos 持久卷挂载）
# ============================================
# 本地开发留空即可（默认 server/src/data）。
# Sealos 应用管理部署时：先创建持久卷并挂载到容器内某路径（如 /app/data），
# 再把该路径填到这里：DATA_DIR=/app/data
# 这样 prompts.json 等文件存储都落到持久卷，重启/重新发布不丢数据。
# 注意：会话/消息/知识库/向量已迁移到 PostgreSQL（见下方 DATABASE_URL），
#       DATA_DIR 目前主要保存 prompts.json。
# DATA_DIR=/app/data

# ============================================
# PostgreSQL + pgvector 连接配置
# ============================================
# 数据库需启用 pgvector 扩展（服务启动时会自动 CREATE EXTENSION IF NOT EXISTS vector，
# 但要求连接的数据库用户具备创建扩展权限，或用超级用户提前执行一次）。
#
# 方式一：用连接串（推荐，Sealos 应用管理里可直接贴数据库实例的内网连接串）
# 格式：postgresql://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_knowledge
#
# 方式二：不用 DATABASE_URL，改用下面字段（二选一，DATABASE_URL 优先）
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=ai_knowledge
# PGUSER=postgres
# PGPASSWORD=postgres

# 托管库需要 SSL 时打开（Sealos / RDS 常见）；本地 docker-compose 不用设
# PGSSL=true
# PGSSLMODE=no-verify

# 连接池大小
# PGPOOL_MAX=10

# Embedding 向量维度（需与 EMBEDDING_MODEL 输出一致，text-embedding-v3 默认 1024）
# EMBEDDING_DIM=1024
